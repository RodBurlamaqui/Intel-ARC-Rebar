# RPM package (Fedora, RHEL, Rocky, Alma, openSUSE). Installing it enables nothing:
# run `sudo arc-rebar diagnose`, then `sudo arc-rebar install`.
# Generated by build-rpm.sh from arc-rebar.spec.in; @VERSION@ is filled in.
Name:           arc-rebar
Version:        @VERSION@
Release:        1
Summary:        Resizable BAR for Intel Arc GPUs on firmware without ReBAR support
License:        LicenseRef-arc-rebar
URL:            https://github.com/RodBurlamaqui/Intel-ARC-Rebar
Source0:        arc-rebar-%{version}.tar.gz
BuildArch:      noarch
Requires:       bash
Requires:       pciutils
Requires:       dracut
Requires:       coreutils
Requires:       /usr/bin/gpgv

%description
Enables the full VRAM aperture of Intel Arc (Battlemage / Alchemist) discrete GPUs
on motherboards whose firmware has no Resizable BAR option, without modifying
firmware. Runs from the dracut initramfs before the GPU driver binds.
Installing this package enables NOTHING by itself. Run 'arc-rebar diagnose',
then 'arc-rebar install' to enable it after safety checks and acceptance of the
licence and disclaimer. Every install first checks that the files are the
official, unmodified release (signed file list).

%prep
%setup -q

%build

%install
d=%{buildroot}/usr/share/arc-rebar
install -d $d %{buildroot}/usr/bin %{buildroot}/usr/share/doc/arc-rebar
install -m0755 diagnose.sh prepare.sh live-test.sh install.sh verify.sh uninstall.sh \
               install-dracut.sh uninstall-dracut.sh dracut-transaction.sh $d/
install -m0644 README.md INSTALL.md DISCLAIMER.md LICENSE CHANGELOG.md SECURITY.md selfcheck.sh $d/
for f in MANIFEST.sha256 MANIFEST.sha256.asc; do [ ! -f "$f" ] || install -m0644 "$f" $d/; done
cp -a hooks scripts dracut docs $d/
install -d $d/diag
cp -a diag/bin diag/src diag/Makefile diag/README.md diag/INSTALL.md $d/diag/
echo %{version} > $d/VERSION
install -m0755 bin/arc-rebar %{buildroot}/usr/bin/arc-rebar
install -m0644 README.md INSTALL.md SECURITY.md %{buildroot}/usr/share/doc/arc-rebar/
find $d -type d -exec chmod 0755 {} +
find $d -type f -name '*.sh' -exec chmod 0755 {} +
chmod 0644 $d/selfcheck.sh
chmod 0755 $d/hooks/arc-rebar $d/scripts/init-premount/arc-rebar

%preun
# Removing the package (not upgrading) also removes the boot hook, but only one this
# package installed; a hook installed from a source copy is left to that copy.
if [ "$1" = 0 ] && [ -e /etc/dracut.conf.d/90-arc-rebar.conf ]; then
  if [ "$(cat /var/lib/arc-rebar/hook-origin 2>/dev/null)" = rpm ]; then
    echo "arc-rebar: removing the boot hook this package installed (rebuilding boot images, please wait)"
    /usr/share/arc-rebar/uninstall-dracut.sh || echo "arc-rebar: could not remove the boot hook; reinstall the package, then run: sudo arc-rebar uninstall" >&2
  else
    echo "arc-rebar: the boot hook was installed from a source copy and is left in place;" >&2
    echo "           remove it with that copy's uninstall-dracut.sh" >&2
  fi
fi
exit 0

%files
%license LICENSE DISCLAIMER.md
/usr/bin/arc-rebar
/usr/share/arc-rebar
/usr/share/doc/arc-rebar
